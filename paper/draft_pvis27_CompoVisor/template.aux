\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  A single-line chart requires \emph  {time} to be unique, which is violated when multiple people share the same time value. A multi-line chart instead requires each \((\emph  {person}, \emph  {time})\) pair to be unique, allowing the observations to form separate trajectories..\relax }}{6}{figure.caption.23}\protected@file@percent }
\newlabel{fig:data-contract-uniqueness}{{5}{6}{A single-line chart requires \emph {time} to be unique, which is violated when multiple people share the same time value. A multi-line chart instead requires each \((\emph {person}, \emph {time})\) pair to be unique, allowing the observations to form separate trajectories..\relax }{figure.caption.23}{}}
\newlabel{fig:data-contract-uniqueness@cref}{{[figure][5][]5}{[1][6][]6}}
