{
  "name": "cv-author-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "./.venv/bin/python -m uvicorn server_python.app.main:app --host 127.0.0.1 --port 8787 --env-file .env",
    "dev:all": "run-p dev:api dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "test": "vitest run",
    "test:phase3-ui": "node scripts/verify-phase3.mjs",
    "test:phase5-ui": "node scripts/verify-layer-fix.mjs",
    "test:llm": "node --env-file=.env scripts/test-llm.mjs",
    "preview": "vite preview",
    "generate:snapshots": "node --no-warnings scripts/generate-chart-snapshots.mjs",
    "generate:linegraph-template": "node scripts/build-linegraph-template.mjs",
    "split:charts": "node --no-warnings scripts/split-chart-layers.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@types/d3": "^7.4.3",
    "@types/d3-axis": "^3.0.6",
    "d3": "^7.9.0",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-hexbin": "^0.2.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "papaparse": "^5.5.4",
    "svgson": "^5.3.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
